{
  "expo": {
    "name": "Medicata",
    "slug": "medicata",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medicata",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Modern healthcare platform for patients, doctors, and pharmacies",
    "primaryColor": "#4a90e2",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.medicata.app",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4a90e2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Medicata to access your camera for video consultations and scanning prescriptions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "294f4c40-b06f-4edb-9d02-cf910a5aaea9"
      }
    },
    "owner": "0x_mrcoder"
  }
}
